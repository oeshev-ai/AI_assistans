# Скопируйте в .env и подставьте свои ключи:
#   copy .env.example .env

# ProxyAPI — fallback (ключ обязателен вместе с POLZA_API_KEY)
PROXYAPI_API_KEY=
PROXYAPI_BASE_URL=https://api.proxyapi.ru/v1

# --- Провайдеры. Дефолт = Polza; ProxyAPI — fallback (нужны оба ключа).
TEXT_PROVIDER=polza              # proxyapi | polza
TEXT_PROVIDER_FALLBACK=proxyapi
IMAGE_PROVIDER=polza             # proxyapi | polza
IMAGE_PROVIDER_FALLBACK=proxyapi
AUDIO_PROVIDER=polza             # proxyapi | polza  (STT и каталожный TTS)
AUDIO_PROVIDER_FALLBACK=proxyapi
VIDEO_PROVIDER=polza             # proxyapi | polza  (Seedance → /v1/media)
VIDEO_PROVIDER_FALLBACK=proxyapi
# Polza.ai: media — POST {POLZA_BASE_URL}/v1/media; chat — {POLZA_CHAT_BASE_URL}/chat/completions.
# Без POLZA_API_KEY при *_PROVIDER=polza (дефолт) — ошибка старта.
POLZA_BASE_URL=https://polza.ai/api
POLZA_CHAT_BASE_URL=https://polza.ai/api/v1
POLZA_API_KEY=
POLZA_COST_MULTIPLIER=0.39       # fallback, если нет usage.cost_rub
POLZA_UPSTREAM_ONLY=OpenAI
POLZA_ALLOW_UPSTREAM_FALLBACKS=0
POLZA_MAX_PRICE_IMAGE_RUB=12     # 0 = без потолка
# Бюджет ожидания картинки, секунды. Видео ждёт max(POLZA_TOTAL_WAIT, 600).
POLZA_TOTAL_WAIT=240
POLZA_POLL_INTERVAL=4
# 1 условный USD ≈ 304 ₽ реального расхода на ProxyAPI (из прайса: 1520/5, 9100/30, 2430/8).
RUB_PER_USD=304
# HMAC-псевдоним Telegram user в Polza media (поле user).
# В production обязательно: иначе SHA256 от id легко перебрать.
# Пример: python -c "import secrets; print(secrets.token_urlsafe(32))"
POLZA_USER_HASH_SECRET=

# Текст / голос / картинки. Имена общие для Polza и ProxyAPI.
# Пустые значения = дефолты.
TEXT_MODEL=deepseek/deepseek-v4.1-flash-1017
TRANSCRIBE_MODEL=openai/whisper-large-v3
# TTS_PROVIDER — поставщик озвучки: polza | speechkit | proxyapi.
# polza и proxyapi — /audio/speech у этого хоста. speechkit — Yandex, нужен YC_*.
TTS_PROVIDER=polza
TTS_MODEL=openai/gpt-4o-mini-tts
TTS_VOICE=alloy
TTS_FORMAT=opus
# SpeechKit TTS v3 (если TTS_PROVIDER=speechkit; роль ai.speechkit-tts.user)
YC_SPEECHKIT_API_KEY=
YC_FOLDER_ID=
SPEECHKIT_VOICE=marina
SPEECHKIT_ROLE=friendly
SPEECHKIT_SPEED=1.0
# SPEECHKIT_URL=https://tts.api.cloud.yandex.net/tts/v3/utteranceSynthesis
IMAGE_MODEL=openai/gpt-image-2.6-flare
IMAGE_EDIT_MODEL=openai/gpt-image-2.6-flare
IMAGE_QUALITY=high
IMAGE_EDIT_SIZE_MODE=source
# Трафик и латентность; провайдер и так ограничивает вход ~1.5k токенов, экономии по деньгам здесь нет.
IMAGE_INPUT_MAX_EDGE=1536
IMAGE_LEGACY_ALIASES=1
# Token bucket картинок. Генерация и правка — разные вёдра.
# 15 сразу, затем около 1 токена за 2 минуты. Одновременно не больше 3 на пользователя.
IMAGE_BUCKET_CAPACITY=15
IMAGE_BUCKET_REFILL_PER_MIN=0.5
IMAGE_MAX_CONCURRENT_PER_USER=3
TEXT_LEGACY_ALIASES=1
TTS_LEGACY_ALIASES=1
VIDEO_MODEL=bytedance/seedance-2.0

# OpenWeatherMap — погода, прогноз, качество воздуха
OPENWEATHER_API_KEY=

# exchangerate.host — конвертация валют
EXCHANGERATE_API_KEY=

# Telegram Bot API — токен от @BotFather, нужен только для bot.py
TELEGRAM_BOT_TOKEN=
# Опционально локально/dev: пусто = все пользователи.
# В production (Docker Compose ENVIRONMENT=production) обязательно задать свой id —
# иначе бот завершится с ошибкой allowlist_required_in_production.
# Узнать id: @userinfobot или логи бота.
# Пример: TELEGRAM_ALLOWED_USER_IDS=123456789
TELEGRAM_ALLOWED_USER_IDS=

# История диалогов. Пустой REDIS_URL — память процесса (локально без Docker).
# В Docker Compose URL собирает entrypoint: redis://:${urlencoded}@redis:6379/0.
# Спецсимволы пароля кодируются. Пустой пароль — URL без userinfo.
REDIS_URL=
# Пароль Redis в compose (requirepass). Пусто допустимо только вне production.
# ENVIRONMENT=production и пустой REDIS_PASSWORD завершают бота и воркер.
REDIS_PASSWORD=
# Память Redis состояния (темы, персоны, FSM, бюджет, лимиты). Медиа очереди
# сюда не кладётся. volatile-ttl снимает ключ с самым коротким TTL.
# Формат: 512mb, 1gb.
REDIS_MAXMEMORY=512mb
# Отдельный инстанс очереди, политика noeviction. Альбом 20 МБ в base64 ≈ 27 МБ;
# 10 таких задач уже 270 МБ, плюс STT до 20 МБ на задачу. Переполнение отвергает
# новую запись до платного вызова, а не снимает arq:result (TTL 60 с) раньше
# payload. Пустой REDIS_QUEUE_URL вне Compose — тот же URL, что REDIS_URL.
# В Compose хост задаёт REDIS_QUEUE_HOST.
REDIS_QUEUE_MAXMEMORY=768mb
REDIS_QUEUE_URL=
# Бот хранит диалоги в темах (TopicHistoryStorage) → TOPIC_TTL_DAYS.
TOPIC_TTL_DAYS=30
MAX_HISTORY_LENGTH=20
# Символы истории после обрезки по числу сообщений. Понижение длины истории
# в настройках персоны необратимо: старые сообщения не возвращаются.
HISTORY_MAX_CHARS=200000
# Оценка входа одного хода. Выше — история дорезается; если не влезает, ход
# отклоняется. Стартовые 64000 при 20 сообщениях почти не срабатывают.
TURN_INPUT_TOKEN_LIMIT=64000
# Грубая оценка: символы текста на токен. Картинка считается отдельно.
CHARS_PER_TOKEN=2.5
IMAGE_TOKEN_ESTIMATE=1200
# Скользящее окно текста и часовой потолок аудио/видео.
TEXT_RATE_LIMIT=10
TEXT_RATE_WINDOW_SEC=60
MEDIA_HOURLY_LIMIT=10
# Свои id из TELEGRAM_ALLOWED_USER_IDS. Пусто — никого. Чужой id роняет старт.
# POWER_USER_IDS=
# Множитель лимитов для своих: текст, медиа/час, ведро картинок, refill, параллельность.
POWER_LIMITS_MULTIPLIER=1.0

# Observability (на VPS рядом с neurophoto не использовать 8081)
METRICS_PORT=8083
# Локально 127.0.0.1; в Docker Compose задаётся 0.0.0.0
METRICS_BIND=127.0.0.1
HEALTH_PORT=8082
# Локально 127.0.0.1; в Docker Compose задаётся 0.0.0.0
HEALTH_BIND=127.0.0.1

# Большие аудио/видео через Yandex Object Storage (опционально).
# Без этих переменных tool request_large_media_upload вернёт ошибку настройки.
# UPLOAD_PUBLIC_BASE_URL — публичный HTTPS до HEALTH_PORT (nginx → 127.0.0.1:8082),
# например https://assist.mrischool.ru
YC_BUCKET_NAME=
YC_ACCESS_KEY_ID=
YC_SECRET_ACCESS_KEY=
# Только официальный хост. Другой адрес, в том числе внутренний IP, останавливает процесс.
YC_S3_ENDPOINT=https://storage.yandexcloud.net
YC_REGION=ru-central1
SIGNED_URL_EXPIRES_IN=1800
UPLOAD_MAX_MB=512
# Параллельная обработка больших upload→STT. Объект пишется на диск, в RAM не дублируется.
UPLOAD_MAX_CONCURRENT=2
# HTTP загрузки (мимо Telegram): 60 GET/мин и 12 POST/10 мин на IP.
UPLOAD_PUBLIC_BASE_URL=
# За nginx с TLS: TRUST_PROXY=1 (в Docker Compose уже задано).
TRUST_PROXY=0
# Legacy browser→S3 presign/complete API (UI использует /file). По умолчанию выкл.
UPLOAD_LEGACY_PRESIGN=0
# UPLOAD_ALLOWED_MIME_TYPES=audio/mpeg,audio/mp4,video/mp4

# Образ для docker compose pull (имя = GHCR из workflow Deploy, lower-case).
# Без переменной локально берётся ai-assistans:local (собирает compose).
# Deploy пишет сюда тег SHA зелёного CI, не latest. Откат — предыдущий SHA.
# APP_IMAGE=ghcr.io/oeshev-ai/ai_assistans:<sha>

# Sentry. В production без DSN бот пишет error в лог (трекинг ошибок выкл.).
# ID пользователя и чата не уходят (send_default_pii=False; before_send чистит PII).
SENTRY_DSN=
ENVIRONMENT=development
APP_VERSION=1.0.0

# Воркер arq для тяжёлых задач (картинки / TTS / STT). По умолчанию выкл. — в процессе бота.
# Чтобы включить: ARQ_ENABLED=1 и запустить воркер:
#   docker compose --profile arq up -d
# Точка входа: arq worker.WorkerSettings
# ARQ_ENABLED=1 без Redis или при сбое пула — SystemExit (fail-closed, без выполнения в процессе бота).
ARQ_ENABLED=0
ARQ_MAX_JOBS=10
# Не меньше 180+POLZA_TOTAL_WAIT+30 (по умолчанию 450): создание и опрос картинки.
# Меньшее значение не даёт arq стартовать.
ARQ_JOB_TIMEOUT=450

# Фото: дешёвый роутер решает, править, рисовать или разобрать снимок.
PHOTO_ROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017
PHOTO_ROUTER_CONFIDENCE=0.55
PHOTO_ROUTER_MAX_TOKENS=600
PHOTO_MAX_CLARIFY_ROUNDS=2
PHOTO_PENDING_TTL_SECONDS=900
ALBUM_DEBOUNCE_SECONDS=1.2
MAX_ALBUM_ITEMS=5
MAX_ALBUM_TOTAL_MB=20
# A — после правки или генерации короткий ответ персоны (текстовая модель, без tools).
# C — шаблон без вызова модели («Готово. Основа — фото N.»). Любое другое значение = A.
PHOTO_CONFIRM_MODE=A
# 1 = при двух номерах фото сразу edit (confidence 1.0), без LLM-роутера.
# В production бот пишет warning. Может ошибаться на «разбери фото» — держите 0.
PHOTO_ROUTER_FAST_PATH=0

# LLM cost controls (USD). 0 = unlimited (только development).
# В production (Docker Compose ENVIRONMENT=production) старт падает, если оба нули —
# задайте хотя бы один потолок до первого `compose up`.
# Пример для прода: LLM_USER_DAILY_BUDGET_USD=1.5  (≈ 450 ₽ ≈ 28 правок на high).
LLM_DAILY_BUDGET_USD=0
LLM_USER_DAILY_BUDGET_USD=0
COST_CHAT_INPUT_PER_1K=0.00015
COST_CHAT_OUTPUT_PER_1K=0.0006
# Плоская ставка, только если в ответе нет usage и размер вне таблицы quality.
COST_IMAGE_USD=0.04
# FLUX klein ~1–2 ₽ ≈ 0.005 USD при RUB_PER_USD=304. Уточнять: Δ₽/N/RUB_PER_USD.
COST_IMAGE_FLUX_USD=0.005
# Плоские ставки по моделям (не-OpenAI), JSON. Пусто → COST_IMAGE_FLUX_USD.
# Пример: {"black-forest-labs/flux-3-image-klein": 0.005}
COST_IMAGE_FLAT_MAP={}
IMAGE_OUT_USD_PER_1M=30
IMAGE_IN_USD_PER_1M=8
TEXT_IN_USD_PER_1M=5
TEXT_OUT_USD_PER_1M=10
COST_STT_PER_MINUTE=0.006
COST_TTS_PER_1K_CHARS=0.015
COST_VIDEO_USD=0.20
