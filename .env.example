# Скопируйте в .env и подставьте свои ключи:
#   copy .env.example .env

# Обязателен для Assist_ai и бота (ProxyAPI)
PROXYAPI_API_KEY=

# Голос (STT/TTS). Пустые значения = дефолты клиента Assist_ai
PROXYAPI_TRANSCRIBE_MODEL=openai/whisper-large-v3
# TTS_PROVIDER=speechkit | proxyapi
TTS_PROVIDER=speechkit
# SpeechKit TTS v3 (сервисный аккаунт, роль ai.speechkit-tts.user)
YC_SPEECHKIT_API_KEY=
YC_FOLDER_ID=
SPEECHKIT_VOICE=marina
SPEECHKIT_ROLE=friendly
SPEECHKIT_SPEED=1.0
# SPEECHKIT_URL=https://tts.api.cloud.yandex.net/tts/v3/utteranceSynthesis
# ProxyAPI TTS (если TTS_PROVIDER=proxyapi)
PROXYAPI_TTS_MODEL=openai/gpt-4o-mini-tts
PROXYAPI_TTS_VOICE=alloy
PROXYAPI_TTS_FORMAT=opus
PROXYAPI_IMAGE_EDIT_MODEL=openai/gpt-image-2.5-flare
PROXYAPI_VIDEO_MODEL=bytedance/seedance-2.0

# OpenWeatherMap — погода, прогноз, качество воздуха
OPENWEATHER_API_KEY=

# exchangerate.host — конвертация валют
EXCHANGERATE_API_KEY=

# Telegram Bot API — токен от @BotFather, нужен только для bot.py
TELEGRAM_BOT_TOKEN=

# История диалогов. Пустой REDIS_URL — память процесса.
# В Docker Compose адрес подставляется сам: redis://redis:6379/0
REDIS_URL=
HISTORY_TTL_DAYS=7
TOPIC_TTL_DAYS=30
MAX_HISTORY_LENGTH=20

# Observability (на VPS рядом с neurophoto не использовать 8081)
METRICS_PORT=8083
HEALTH_PORT=8082

# Большие аудио/видео через Yandex Object Storage (опционально).
# Без этих переменных tool request_large_media_upload вернёт ошибку настройки.
# UPLOAD_PUBLIC_BASE_URL — публичный HTTPS до HEALTH_PORT (nginx → 127.0.0.1:8082),
# например https://assist.mrischool.ru
YC_BUCKET_NAME=
YC_ACCESS_KEY_ID=
YC_SECRET_ACCESS_KEY=
YC_S3_ENDPOINT=https://storage.yandexcloud.net
YC_REGION=ru-central1
SIGNED_URL_EXPIRES_IN=1800
UPLOAD_MAX_MB=512
UPLOAD_PUBLIC_BASE_URL=
# UPLOAD_ALLOWED_MIME_TYPES=audio/mpeg,audio/mp4,video/mp4

# Sentry error tracking (optional)
SENTRY_DSN=
ENVIRONMENT=development
APP_VERSION=1.0.0

# arq worker for heavy jobs (image / TTS / STT). Requires Redis + worker process.
ARQ_ENABLED=0
ARQ_MAX_JOBS=10
ARQ_JOB_TIMEOUT=300

# LLM cost controls (USD). 0 = unlimited.
LLM_DAILY_BUDGET_USD=0
LLM_USER_DAILY_BUDGET_USD=0
COST_CHAT_INPUT_PER_1K=0.00015
COST_CHAT_OUTPUT_PER_1K=0.0006
COST_IMAGE_USD=0.04
COST_STT_PER_MINUTE=0.006
COST_TTS_PER_1K_CHARS=0.015
