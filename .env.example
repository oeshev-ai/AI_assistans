# Скопируйте в .env и подставьте свои ключи:
#   copy .env.example .env

# Обязателен для Assist_ai и бота (ProxyAPI)
PROXYAPI_API_KEY=
PROXYAPI_BASE_URL=https://api.proxyapi.ru/v1

# --- Провайдеры (мультипровайдерный доступ). Пустые/дефолтные значения =
# --- поведение как раньше: всё через ProxyAPI.
TEXT_PROVIDER=proxyapi
IMAGE_PROVIDER=proxyapi          # polza после приёмки
IMAGE_PROVIDER_FALLBACK=proxyapi
AUDIO_PROVIDER=proxyapi
VIDEO_PROVIDER=proxyapi
# Polza.ai (картинки через POST /v1/media). Без ключа провайдер не регистрируется.
POLZA_BASE_URL=https://polza.ai/api
POLZA_API_KEY=
POLZA_COST_MULTIPLIER=0.39       # fallback, если нет usage.cost_rub
POLZA_UPSTREAM_ONLY=OpenAI
POLZA_ALLOW_UPSTREAM_FALLBACKS=0
POLZA_MAX_PRICE_IMAGE_RUB=12     # 0 = без потолка
POLZA_TOTAL_WAIT=240
POLZA_POLL_INTERVAL=4
# 1 условный USD ≈ 304 ₽ реального расхода на ProxyAPI (из прайса: 1520/5, 9100/30, 2430/8).
RUB_PER_USD=304

# Текст / голос / картинки. Пустые значения = дефолты клиента Assist_ai
PROXYAPI_TEXT_MODEL=deepseek/deepseek-v4.1-flash
PROXYAPI_TRANSCRIBE_MODEL=openai/whisper-large-v3
# TTS_PROVIDER=proxyapi | speechkit  (дефолт кода — proxyapi; speechkit нужен YC_*)
TTS_PROVIDER=proxyapi
PROXYAPI_TTS_MODEL=openai/gpt-4o-mini-tts
PROXYAPI_TTS_VOICE=alloy
PROXYAPI_TTS_FORMAT=opus
# SpeechKit TTS v3 (если TTS_PROVIDER=speechkit; роль ai.speechkit-tts.user)
YC_SPEECHKIT_API_KEY=
YC_FOLDER_ID=
SPEECHKIT_VOICE=marina
SPEECHKIT_ROLE=friendly
SPEECHKIT_SPEED=1.0
# SPEECHKIT_URL=https://tts.api.cloud.yandex.net/tts/v3/utteranceSynthesis
PROXYAPI_IMAGE_MODEL=openai/gpt-image-2.6-flare
PROXYAPI_IMAGE_EDIT_MODEL=openai/gpt-image-2.6-flare
IMAGE_QUALITY=high
# complexity: параметр принимается API (enum валидируется: low/medium/high),
# но на плотной афише 1024x1536/high эффект по времени/токенам/картинке
# не обнаружен (n=3 на плечо, медианы 11.66s low / 11.46s high).
# Держим low для правок, high для генерации как бесплатную ставку.
IMAGE_COMPLEXITY_GENERATE=high
IMAGE_COMPLEXITY_EDIT=low
IMAGE_EDIT_SIZE_MODE=source
# Трафик и латентность; провайдер и так ограничивает вход ~1.5k токенов, экономии по деньгам здесь нет.
IMAGE_INPUT_MAX_EDGE=1536
IMAGE_SEND_COMPLEXITY=1
IMAGE_LEGACY_ALIASES=1
TEXT_LEGACY_ALIASES=1
PROXYAPI_VIDEO_MODEL=bytedance/seedance-2.0

# OpenWeatherMap — погода, прогноз, качество воздуха
OPENWEATHER_API_KEY=

# exchangerate.host — конвертация валют
EXCHANGERATE_API_KEY=

# Telegram Bot API — токен от @BotFather, нужен только для bot.py
TELEGRAM_BOT_TOKEN=
# Опционально локально/dev: пусто = все пользователи.
# В production (Docker Compose ENVIRONMENT=production) обязательно задать свой id —
# иначе бот завершится с ошибкой allowlist_required_in_production.
# Узнать id: @userinfobot или логи бота.
TELEGRAM_ALLOWED_USER_IDS=

# История диалогов. Пустой REDIS_URL — память процесса (локально без Docker).
# В Docker Compose URL собирается сам: redis://:${REDIS_PASSWORD}@redis:6379/0
REDIS_URL=
# Опционально: пароль Redis в compose (requirepass). Пусто = без пароля.
REDIS_PASSWORD=
# Бот хранит диалоги в темах (TopicHistoryStorage) → TOPIC_TTL_DAYS.
# HISTORY_TTL_DAYS — только для legacy app/storage/history_storage.py (не wired в bot).
HISTORY_TTL_DAYS=7
TOPIC_TTL_DAYS=30
MAX_HISTORY_LENGTH=20

# Observability (на VPS рядом с neurophoto не использовать 8081)
METRICS_PORT=8083
# Локально 127.0.0.1; в Docker Compose задаётся 0.0.0.0
METRICS_BIND=127.0.0.1
HEALTH_PORT=8082
# Локально 127.0.0.1; в Docker Compose задаётся 0.0.0.0
HEALTH_BIND=127.0.0.1

# Большие аудио/видео через Yandex Object Storage (опционально).
# Без этих переменных tool request_large_media_upload вернёт ошибку настройки.
# UPLOAD_PUBLIC_BASE_URL — публичный HTTPS до HEALTH_PORT (nginx → 127.0.0.1:8082),
# например https://assist.mrischool.ru
YC_BUCKET_NAME=
YC_ACCESS_KEY_ID=
YC_SECRET_ACCESS_KEY=
YC_S3_ENDPOINT=https://storage.yandexcloud.net
YC_REGION=ru-central1
SIGNED_URL_EXPIRES_IN=1800
UPLOAD_MAX_MB=512
# Параллельная обработка больших upload→STT (лимит RAM: файл целиком в памяти).
UPLOAD_MAX_CONCURRENT=2
UPLOAD_PUBLIC_BASE_URL=
# За nginx с TLS: TRUST_PROXY=1 (в Docker Compose уже задано).
TRUST_PROXY=0
# Legacy browser→S3 presign/complete API (UI использует /file). По умолчанию выкл.
UPLOAD_LEGACY_PRESIGN=0
# UPLOAD_ALLOWED_MIME_TYPES=audio/mpeg,audio/mp4,video/mp4

# Docker image for compose pull (must match GHCR name from Deploy workflow).
# Local default without this var: ai-assistans:local (built by compose).
# APP_IMAGE=ghcr.io/<owner>/<repo>:latest

# Sentry error tracking (optional). Telegram user/chat IDs are not attached
# (send_default_pii=False; before_send strips residual identity fields).
SENTRY_DSN=
ENVIRONMENT=development
APP_VERSION=1.0.0

# arq worker for heavy jobs (image / TTS / STT). Default off = inline in bot.
# To enable: set ARQ_ENABLED=1 here AND start worker:
#   docker compose --profile arq up -d
# Worker entrypoint: arq worker.WorkerSettings
ARQ_ENABLED=0
ARQ_MAX_JOBS=10
# Must be >= POLZA_TOTAL_WAIT+30 (default 270). Shorter value aborts arq start.
ARQ_JOB_TIMEOUT=300

# Фото: дешёвый роутер решает, править, рисовать или разобрать снимок.
PHOTO_ROUTER_MODEL=deepseek/deepseek-v4.1-flash
PHOTO_ROUTER_CONFIDENCE=0.55
PHOTO_ROUTER_MAX_TOKENS=600
PHOTO_MAX_CLARIFY_ROUNDS=2
PHOTO_PENDING_TTL_SECONDS=900
ALBUM_DEBOUNCE_SECONDS=1.2
MAX_ALBUM_ITEMS=5
MAX_ALBUM_TOTAL_MB=20
ALLOW_COMPOSITE_FALLBACK=0
PHOTO_CONFIRM_MODE=A
# 1 = при двух номерах фото сразу edit (confidence 1.0), без LLM-роутера.
# В production бот пишет warning. Может ошибаться на «разбери фото» — держите 0.
PHOTO_ROUTER_FAST_PATH=0

# LLM cost controls (USD). 0 = unlimited (только development).
# В production (ENVIRONMENT=production) старт падает, если оба нули —
# задайте хотя бы один потолок. Пример: 1.5 ≈ 450 ₽ ≈ 28 правок на high.
LLM_DAILY_BUDGET_USD=0
LLM_USER_DAILY_BUDGET_USD=0
COST_CHAT_INPUT_PER_1K=0.00015
COST_CHAT_OUTPUT_PER_1K=0.0006
# Плоская ставка, только если в ответе нет usage и размер вне таблицы quality.
COST_IMAGE_USD=0.04
# FLUX klein ~1–2 ₽ ≈ 0.005 USD при RUB_PER_USD=304. Уточнять: Δ₽/N/RUB_PER_USD.
COST_IMAGE_FLUX_USD=0.005
# Плоские ставки по моделям (не-OpenAI), JSON. Пусто → COST_IMAGE_FLUX_USD.
# Пример: {"black-forest-labs/flux-3-image-klein": 0.005}
COST_IMAGE_FLAT_MAP={}
IMAGE_OUT_USD_PER_1M=30
IMAGE_IN_USD_PER_1M=8
TEXT_IN_USD_PER_1M=5
TEXT_OUT_USD_PER_1M=10
COST_STT_PER_MINUTE=0.006
COST_TTS_PER_1K_CHARS=0.015
COST_VIDEO_USD=0.20
